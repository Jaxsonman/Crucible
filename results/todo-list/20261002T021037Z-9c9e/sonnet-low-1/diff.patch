 """To-do list stored in a JSON file."""
 
+import json
+import os
+
 
 class TodoList:
     def __init__(self, path):
-        raise NotImplementedError
+        self._path = os.fspath(path)
+        self._items = []
+        self._next_id = 1
+        if os.path.exists(self._path):
+            with open(self._path, encoding="utf-8") as f:
+                data = json.load(f)
+            self._items = data["items"]
+            self._next_id = data["next_id"]
+
+    def _save(self):
+        tmp = self._path + ".tmp"
+        with open(tmp, "w", encoding="utf-8") as f:
+            json.dump({"next_id": self._next_id, "items": self._items}, f)
+        os.replace(tmp, self._path)
+
+    def _find(self, item_id):
+        for item in self._items:
+            if item["id"] == item_id:
+                return item
+        raise KeyError(item_id)
 
     def add(self, title):
-        raise NotImplementedError
+        if not isinstance(title, str):
+            raise TypeError("title must be a string")
+        title = title.strip()
+        if not title:
+            raise ValueError("title must not be empty")
+        item_id = self._next_id
+        self._items.append({"id": item_id, "title": title, "done": False})
+        self._next_id += 1
+        self._save()
+        return item_id
 
     def complete(self, item_id):
-        raise NotImplementedError
+        self._find(item_id)["done"] = True
+        self._save()
 
     def delete(self, item_id):
-        raise NotImplementedError
+        self._items.remove(self._find(item_id))
+        self._save()
 
     def items(self, include_done=True):
-        raise NotImplementedError
+        return [dict(i) for i in self._items if include_done or not i["done"]]
